{
  "name": "harbour-lite",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A local-first agent workbench you can make your own.",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "tsx scripts/test-ui.ts",
    "test:desktop": "npm run build && tsx scripts/test-desktop.ts",
    "audit:public": "node scripts/audit-public.mjs",
    "format": "prettier --write src web scripts tests desktop/main.cjs",
    "desktop": "npm run build && npm --prefix desktop start"
  },
  "dependencies": {
    "dotenv": "18.0.8",
    "yaml": "2.9.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
