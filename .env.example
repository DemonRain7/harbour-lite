# Default: offline demo, no account or paid API required.
HARBOUR_LITE_HOST=127.0.0.1
HARBOUR_LITE_PORT=7799
# Required when listening on a non-loopback address. Use HTTPS via a reverse proxy.
HARBOUR_LITE_TOKEN=
# Optional custom private data directory; relative paths resolve from this project.
HARBOUR_LITE_DATA=data
# Model secrets are saved here by Settings, never returned by the API.
