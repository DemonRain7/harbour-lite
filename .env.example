# 公开版独立运行，不读取另一份 Harbour 的 .env。
WEB_HOST=127.0.0.1
WEB_PORT=7799
WEB_AUTH_TOKEN=
DEFAULT_AGENT=main-assistant
# 首次启动仅离线演示；配置模型后改为 false。
MOCK_LLM=true
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_FALLBACK_API_KEY=
ANTHROPIC_FALLBACK_AUTH_TOKEN=
ANTHROPIC_FALLBACK_BASE_URL=
OPENROUTER_API_KEY=
CLAUDE_AGENT_MODEL=sonnet
MODEL_HOST_ALLOWLIST=api.anthropic.com,api.deepseek.com,api.kimi.com,api.moonshot.cn,openrouter.ai
ENABLE_CODEX_HARNESS=false
ENABLE_DSH_HARNESS=false
ENABLE_DESKTOP_CONTROL=false
OPENCLI_BROWSER_AUTOSTART=false
HARBOUR_DATA_HOME=./data/runtime
HARBOUR_MIGRATE_LEGACY=false
HEARTBEAT_ENABLED=false
